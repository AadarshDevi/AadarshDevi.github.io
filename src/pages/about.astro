---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import '../styles/global.css';
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "About Me";

const identity = {
    name: "Aadarsh Devi",
    careerField: "Robotics",
    hobbies: [
        "Electronics",
        "Java Programming",
        "Gaming"
    ],
    skills: [
        "Java", "C", "C++", "Python", "HTML", "CSS", "Arduino", "ESP32"
    ],
    collegeMajor: "Computer Engineering"
}

const working = true;

const skillColor = "crimson";
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="generator" content={Astro.generator}/>
    <title>{pageTitle}</title>
    <style define:vars={
        {skillColor}
    }>
        .skill {
            color: deepskyblue;
            font-weight: bold;
        }
    </style>
</head>
<body>


<div id="container">
    <img id="background" src={background.src} alt="" fetchpriority="high"/>
    <main>
        <section id="hero">
            <img src={astroLogo.src} width="115" height="48" alt="Astro Homepage"/>
            <h1>{pageTitle}</h1>
            <!--<h2>My Website v9 (Astro Website v1)</h2>-->
            <!--<p>9th Website about me but my 1st Website using Astro. The others were HTML and CSS.</p>-->
            <p>
                My name is {identity.name}. I am a college student studying {identity.collegeMajor}. I want to work
                in {identity.careerField}. During my free time, I do {identity.hobbies.join(", ")}. Some skills I know
                are:
            </p>
            <ul>
                {identity.skills.map((skill) =>
                        <li class="skill">{skill}</li>)}
            </ul>
            <section id="links">
                <Navigation/>
            </section>
            {
                working &&
                    <p>I am currently working on my projects.</p>
            }
        </section>
    </main>
</div>

<Footer/>
</body>
</html>